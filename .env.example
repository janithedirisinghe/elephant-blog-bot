# Copy this file to ".env" and paste your real keys.
# Both are free and need no credit card.

# From https://console.groq.com  ->  API Keys
GROQ_API_KEY=your-groq-key-here

# From https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=your-gemini-key-here

# Kill switch: false/0/no/off disables the bot (crew.py exits). Defaults to true.
BOT_ENABLED=true

# Optional: override the editing/writing model (e.g. when a free-tier quota is hit).
# QUALITY_MODEL=gemini/gemini-2.5-flash-lite

# Blog backend (Tuskers): when set, finished drafts are POSTed as pending articles.
# BLOG_API_URL=https://<api-host>/articles/bot
# BOT_API_KEY=<must match the backend's BOT_API_KEY>
